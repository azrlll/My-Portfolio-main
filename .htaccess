# ==============================================================================
# InfinityFree Portfolio Configuration
# ==============================================================================

# Enable Rewrite Engine
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Allow Google Search Console verification files, robots.txt, sitemap.xml, and version.json directly
    RewriteRule ^(google[a-f0-9]+\.html|robots\.txt|sitemap\.xml|version\.json)$ - [L]

    # 2. Allow all existing files and directories to be served directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
</IfModule>

# Disable directory listing
Options -Indexes

# ==============================================================================
# Browser & Edge Caching Strategy (Prevents Stale Cache on Deploys)
# ==============================================================================
<IfModule mod_headers.c>
    # 1. HTML & PHP Pages: Revalidate on every request so visitors immediately see new deploys
    <FilesMatch "\.(html|php)$">
        Header set Cache-Control "no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

    # 2. Deployment Version File: Always fresh verification
    <FilesMatch "^(version\.json|google[a-f0-9]+\.html)$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

    # 3. Versioned CSS & JS: Safe to cache because URL contains ?v=cache-buster
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
    </FilesMatch>

    # 4. Static Images & Webfonts: Long-term caching
    <FilesMatch "\.(ico|jpe?g|png|gif|svg|webp|woff|woff2|ttf|eot)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>

# Protect sensitive files and credentials
<FilesMatch "(^\.env|composer\.(json|lock)|package(-lock)?\.json|\.git)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
